# Python generated files
__pycache__
*.pyc

# Sphinx generated files
doc/build
doc/source/volatility3.*

# Pycharm/PyDev development files
workspace.xml
.idea
.vscode

# Manually generated files
.mypy_cache
stubs
volatility3/symbols/linux*
volatility3/symbols/windows*
volatility3/symbols/mac*

# Mac metadata files
.DS_Store

# Volatility's config
config*.json

# Pyinstaller files
build
dist
*.egg-info

# Environments
.env
.venv
env/
venv/
ENV/

# Memory dump files
*.dmp
*.vmem
*.img

# PyTest cache files
.pytest_cache/

# Coverage cache
.coverage

# Volatility GUI output
output/

# vol-rs binary, installed by install_vol_rs.py
bin/

# Kernel symbol (ISF) files added by the user, tens of MB each.
# The vmcs *-architecture.json files that ship with Volatility stay tracked.
volatility3/symbols/generic/**/*.json
!volatility3/symbols/generic/vmcs/*-architecture.json
*.json.xz
*.ddeb

# More memory image formats
*.raw
*.mem
*.lime
*.vmsn
*.vmss
*.core
*.E01
*.aff4
